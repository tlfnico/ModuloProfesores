# Variables de entorno para desarrollo local — Sistema Profesor (SGA)
#
# Copiar este archivo como .env y ajustar los valores según tu entorno.
# NUNCA incluir secretos reales en .env.example ni en el control de versiones.
#
# Para que Django los lea, este archivo .env debe estar en backend/ (mismo
# directorio que manage.py).

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=django-insecure-dev-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Base de datos (por defecto PostgreSQL; usar django.db.backends.sqlite3 para desarrollo aislado)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sga_profesor
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
